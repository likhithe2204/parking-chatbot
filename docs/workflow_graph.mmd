---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	chatbot(chatbot)
	escalate(escalate)
	await_approval(await_approval)
	record(record)
	notify(notify)
	__end__([<p>__end__</p>]):::last
	__start__ --> chatbot;
	await_approval -.-> notify;
	await_approval -.-> record;
	chatbot -. &nbsp;reply&nbsp; .-> __end__;
	chatbot -.-> escalate;
	escalate -. &nbsp;reply&nbsp; .-> __end__;
	escalate -.-> await_approval;
	record --> notify;
	notify --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
